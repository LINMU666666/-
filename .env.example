# DingTalk Bot configuration
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it is listed in .gitignore.

# Required: DingTalk group robot webhook URL
# Obtain from: DingTalk group → Group Settings → Smart Group Assistant → Add Robot → Custom → Webhook
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN

# Optional: signing secret (加签密钥) — leave empty if you chose IP whitelist instead
DINGTALK_SECRET=

# Optional: app-level secret used to verify requests arriving at /dingtalk/callback
# Set this if you have an outgoing robot (企业内部机器人) configured in DingTalk
DINGTALK_APP_SECRET=
